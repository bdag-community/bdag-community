# BDAG Community — local environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# ALL values are OPTIONAL for a first run: with no Supabase project wired, the
# site serves the seed news articles from src/lib/content/news-seed.ts and the
# contact form degrades to showing the community channels instead of storing
# messages. Wire Supabase to enable the news admin + contact inbox.

# Supabase project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — SERVER ONLY.
# WARNING: This key bypasses Row Level Security. It must NEVER be prefixed
# with NEXT_PUBLIC_ and must never reach the browser. Use only in server-side
# code (DAL / Route Handlers / Server Actions).
SUPABASE_SECRET_KEY=

# Canonical origin for metadata/OG URLs (defaults to https://bdag.community).
NEXT_PUBLIC_SITE_URL=

# Suggestion Box email delivery through Resend. All three are required at
# runtime; if any is absent, the form states that nothing was sent.
RESEND_API_KEY=
SUGGESTION_NOTIFY_EMAIL=
SUGGESTION_FROM_EMAIL=

# Cloudflare Turnstile and durable submission limits. The site key is public
# and baked into the client build. The other values are SERVER ONLY.
# Use Cloudflare official test credentials locally and a BlockDAG Engineering
# production widget restricted to bdag.community for deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_TEST_MODE=false
ABUSE_HMAC_SECRET=

# Private article-cover quarantine in the BlockDAG Engineering AWS account.
# All values are SERVER ONLY. The review container uses development even though
# it runs a production-mode Next build. Production credentials are not created
# until the public rollout step.
ASSET_STORAGE_ENVIRONMENT=development
ASSET_S3_REGION=eu-central-1
ASSET_S3_BUCKET=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_CAPABILITY_HMAC_SECRET=

# Separate read/moderation credential. Never reuse the intake Put-only key.
# Development is configured in Step 10. Production stays empty until rollout.
ASSET_MODERATION_S3_ACCESS_KEY_ID=
ASSET_MODERATION_S3_SECRET_ACCESS_KEY=

# Controlled public delivery. Development uses its exact CloudFront default
# origin. Production is fixed to https://assets.bdag.community. This value is
# non-secret but is required at both build time (CSP) and runtime (URL mapping).
ASSET_DELIVERY_ORIGIN=
